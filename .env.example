# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_* são embutidas no app no
# momento do bundle — reinicie o `npx expo start` depois de alterar.

# Endereço da PhytoraAPI.
# Emulador Android: http://10.0.2.2:3080 (alias do localhost da máquina)
# Celular físico na mesma rede: http://<IP da máquina>:3080
EXPO_PUBLIC_API_URL=http://10.0.2.2:3080
